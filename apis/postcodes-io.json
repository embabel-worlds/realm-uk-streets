{
  "openapi": "3.0.3",
  "info": {
    "title": "postcodes.io",
    "version": "1.0.0",
    "description": "Free, keyless UK postcode and place geography \u2014 OS and ONS open data. The bridge between how people name places (a postcode, a town) and the coordinates every other surface is keyed on."
  },
  "servers": [
    {
      "url": "https://api.postcodes.io"
    }
  ],
  "paths": {
    "/postcodes/{postcode}": {
      "get": {
        "operationId": "lookupPostcode",
        "summary": "A postcode's coordinates and administrative geography",
        "description": "`result` carries `latitude`, `longitude`, `admin_district`, `region`, `parliamentary_constituency` and more. 404 for postcodes that do not exist \u2014 offer `searchPlaces` for a town name instead.",
        "parameters": [
          {
            "name": "postcode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The postcode, spaces allowed, e.g. `SW1A 1AA`."
          }
        ],
        "responses": {
          "200": {
            "description": "Postcode record under `result`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/places": {
      "get": {
        "operationId": "searchPlaces",
        "summary": "Search UK place names (towns, villages, suburbs) \u2014 OS Open Names",
        "description": "`result` is an array of places with `name_1`, `county_unitary`, `region`, `local_type`, `latitude`, `longitude`. Empty result means no match, not an error.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The place name to search, e.g. `Shoreditch`."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Maximum results, default 10."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching places under `result`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/postcodes": {
      "get": {
        "operationId": "reverseGeocode",
        "summary": "The postcodes nearest a coordinate pair",
        "description": "`result` is an array (nearest first) with `postcode`, `admin_district`, `distance` in metres \u2014 or null when nothing is near. The DEFAULT radius is only 100 m; pass `radius` (max 2000) for anything resolved from a map click.",
        "parameters": [
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Longitude, decimal degrees."
          },
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Latitude, decimal degrees."
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search radius in metres, max 2000. The 100 m default misses almost everything a coarse pointer produces."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Maximum results, default 10."
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest postcodes under `result`, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/outcodes/{outcode}": {
      "get": {
        "operationId": "lookupOutcode",
        "summary": "An outward postcode district's centroid and the areas it spans",
        "description": "The zoomed-OUT level of the two-level search: `result` carries the district-level `latitude`/`longitude` centroid and arrays `admin_district`, `admin_ward`, `parliamentary_constituency` (an outcode can span several). Use it to watch an area like `SE10` rather than one street.",
        "parameters": [
          {
            "name": "outcode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The outward code, e.g. `SE10`."
          }
        ],
        "responses": {
          "200": {
            "description": "Outcode record under result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/outcodes": {
      "get": {
        "operationId": "reverseOutcode",
        "summary": "The nearest outward postcode districts to a coordinate pair",
        "description": "The wide-net fallback when no full postcode is within 2 km \u2014 remote uplands still belong to an outcode. `result` is nearest-first with `outcode` and centroid coordinates, or null offshore.",
        "parameters": [
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Longitude, decimal degrees."
          },
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Latitude, decimal degrees."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Maximum results, default 10."
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest outcodes under result, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}